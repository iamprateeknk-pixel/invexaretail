{
  "openapi": "3.1.0",
  "info": {
    "title": "Invexa Retail API - extracted modules",
    "version": "2026.11.0",
    "description": "Versioned contract for extracted thin-route modules. Week 10 covers Item Search / Stock Detail / Adjustment-Reversal and Week 11 covers the staged import lifecycle."
  },
  "servers": [
    { "url": "https://invexaretail-h1ps.onrender.com/api/v1", "description": "production" },
    { "url": "http://localhost:4000/api/v1", "description": "local" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "requestId",
        "in": "query",
        "required": false,
        "description": "Client-supplied idempotency key. Mutating endpoints that accept one return the original result on replay instead of double-posting (ADR-006). Most endpoints in this contract take it as a body field, not a query parameter - see each operation.",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "description": "The stable error shape (ADR-006 / lib/errors.ts's DomainError) that new and extracted code returns. Not yet the shape of every endpoint in the full API - see AGENTS.md's Error catalog row.",
        "required": ["error", "code", "traceId"],
        "properties": {
          "error": { "type": "string", "description": "Human-readable message. May change wording without notice - do not branch on it." },
          "code": {
            "type": "string",
            "description": "Stable, SCREAMING_SNAKE_CASE. Clients branch on this.",
            "enum": ["INSUFFICIENT_STOCK", "INVALID_TRANSITION", "CONCURRENT_UPDATE_CONFLICT", "DUPLICATE_REQUEST", "NOT_FOUND", "VALIDATION_FAILED"]
          },
          "traceId": { "type": "string", "description": "Correlates this rejection to server logs and the audit trail." }
        }
      },
      "LegacyErrorMessage": {
        "type": "object",
        "description": "The older, pre-Week-7 error shape most of these endpoints still use for validation/role failures (see each operation's 4xx responses for which shape applies).",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      },
      "TransferLine": {
        "type": "object",
        "required": ["itemId", "lotId", "quantity"],
        "properties": {
          "itemId": { "type": "string" },
          "lotId": { "type": "string" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "TransferCreateRequest": {
        "type": "object",
        "required": ["sourceLocationId", "destinationLocationId", "lines"],
        "properties": {
          "sourceLocationId": { "type": "string" },
          "destinationLocationId": { "type": "string" },
          "cartonCount": { "type": "integer", "minimum": 1 },
          "notes": { "type": "string" },
          "photos": { "type": "array", "items": { "type": "string" } },
          "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/TransferLine" } }
        }
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sourceLocationId": { "type": "string" },
          "destinationLocationId": { "type": "string" },
          "status": { "type": "string", "enum": ["DRAFT", "SUBMITTED", "PENDING_PICK", "REQUESTED", "PICKING", "PARTIAL", "PICKED", "READY_FOR_ADMIN", "CONFIRMED", "IN_TRANSIT", "DISPATCHED", "PARTIALLY_RECEIVED", "PARTIAL_RECEIVED", "RECEIVED", "CLOSED", "REJECTED", "CANCELLED"] },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/TransferLine" } },
          "cartonCount": { "type": "integer" },
          "notes": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "TransferListItem": {
        "allOf": [
          { "$ref": "#/components/schemas/Transfer" },
          {
            "type": "object",
            "properties": {
              "cartons": { "type": "array", "items": { "type": "object", "properties": { "packageId": { "type": "string" }, "quantity": { "type": "number" }, "weightKg": { "type": "number" } } } },
              "delayed": { "type": "boolean" }
            }
          }
        ]
      },
      "Branch": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string", "description": "Immutable after creation." },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] },
          "address": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "email": { "type": "string", "nullable": true },
          "managerId": { "type": "string", "nullable": true },
          "workingHours": { "type": "string", "nullable": true }
        }
      },
      "BranchCreateRequest": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string" },
          "managerId": { "type": "string" },
          "workingHours": { "type": "string" }
        }
      },
      "BranchArchiveBlockers": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "blockers": {
            "type": "object",
            "properties": {
              "activeStock": { "type": "integer" },
              "openTransfers": { "type": "integer" },
              "pendingWork": { "type": "integer" }
            }
          }
        }
      },
      "ItemSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "unit": { "type": "string" }
        }
      },
      "ItemSearchPage": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/ItemSummary" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Opaque cursor (the last item's id). Pass back verbatim as `cursor` to fetch the next page; null means no more pages." }
        }
      },
      "Movement": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "movementType": { "type": "string", "enum": ["OPENING_STOCK", "PURCHASE_RECEIPT", "SALES_DEDUCTION", "SALES_RETURN", "TRANSFER_OUT", "TRANSFER_IN", "COUNT_VARIANCE", "ADJUSTMENT", "WASTE", "DAMAGE", "EXPIRY_WRITE_OFF"] },
          "qtyDelta": { "type": "number" },
          "beforeBalance": { "type": "number" },
          "afterBalance": { "type": "number" },
          "locationId": { "type": "string" },
          "lotId": { "type": "string", "nullable": true },
          "reason": { "type": "string", "nullable": true },
          "sourceDocument": { "type": "string", "nullable": true },
          "actor": { "type": "string", "nullable": true },
          "timestamp": { "type": "string", "format": "date-time" },
          "reversalOf": { "type": "string", "nullable": true, "description": "The id of the movement this one reverses, if any." }
        }
      },
      "BranchBalance": {
        "type": "object",
        "properties": {
          "locationId": { "type": "string" },
          "locationName": { "type": "string" },
          "onHand": { "type": "number" },
          "reserved": { "type": "number" },
          "quarantine": { "type": "number" },
          "damaged": { "type": "number" },
          "available": { "type": "number" }
        }
      },
      "LotDetail": {
        "type": "object",
        "properties": {
          "lotId": { "type": "string" },
          "lotNo": { "type": "string" },
          "expiryDate": { "type": "string", "format": "date-time", "nullable": true },
          "status": { "type": "string", "enum": ["AVAILABLE", "EXPIRED", "BLOCKED", "QUARANTINE"] },
          "totalOnHand": { "type": "number" }
        }
      },
      "ReconciliationStatus": {
        "type": "object",
        "description": "Whether StockLedger.onHand for one (lot, location) agrees with the sum of every StockMovement journal row for it - computed live from the canonical journal/projection (ADR-001), the same way scripts/reconcile-stock-journal.mjs does.",
        "properties": {
          "explained": { "type": "boolean" },
          "journalSum": { "type": "number" },
          "onHand": { "type": "number" },
          "delta": { "type": "number" }
        }
      },
      "StockDetail": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string" },
          "itemCode": { "type": "string" },
          "itemName": { "type": "string" },
          "branches": { "type": "array", "items": { "$ref": "#/components/schemas/BranchBalance" } },
          "lots": { "type": "array", "items": { "$ref": "#/components/schemas/LotDetail" } },
          "movements": { "type": "array", "items": { "$ref": "#/components/schemas/Movement" } },
          "reconciliation": { "type": "array", "items": { "$ref": "#/components/schemas/ReconciliationStatus" } }
        }
      },
      "AdjustRequest": {
        "type": "object",
        "required": ["locationId", "lotId", "qtyDelta", "reason", "idempotencyKey"],
        "properties": {
          "locationId": { "type": "string" },
          "lotId": { "type": "string" },
          "qtyDelta": { "type": "number", "description": "Positive to add stock, negative to remove. Never zero." },
          "reason": { "type": "string" },
          "idempotencyKey": { "type": "string", "description": "Client-generated (e.g. a UUID). Retrying with the same key returns the original result instead of posting again." }
        }
      },
      "PostMovementResult": {
        "type": "object",
        "properties": {
          "duplicate": { "type": "boolean", "description": "True if this idempotency key had already been posted - the movement/balance below are the ORIGINAL result, not a new post." },
          "movement": { "$ref": "#/components/schemas/Movement" },
          "balance": { "type": "object", "properties": { "onHand": { "type": "number" } } }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/transfers/list": {
      "get": {
        "operationId": "listTransfers",
        "summary": "List transfers visible to the caller's access context (location-scoped).",
        "tags": ["Transfers"],
        "responses": {
          "200": {
            "description": "Transfers the caller can see by source or destination location access.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "transfers": { "type": "array", "items": { "$ref": "#/components/schemas/TransferListItem" } } } } } }
          },
          "401": { "description": "No or invalid credentials." }
        }
      }
    },
    "/transfers": {
      "post": {
        "operationId": "createTransfer",
        "summary": "Request a transfer. Reserves source stock atomically before the transfer row is created.",
        "tags": ["Transfers"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransferCreateRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "transfer": { "$ref": "#/components/schemas/Transfer" } } } } }
          },
          "400": { "description": "Validation failed (bad payload, wrong destination type for a store user's request, etc.).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "403": { "description": "Role or location-access check failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "409": { "description": "Expiry-blocked lot.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "422": {
            "description": "Insufficient stock to reserve - the stable DomainError envelope (ADR-006/Week 7).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/branches": {
      "get": {
        "operationId": "listBranches",
        "summary": "List all branches.",
        "tags": ["Branches"],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "object", "properties": { "branches": { "type": "array", "items": { "$ref": "#/components/schemas/Branch" } } } } } } }
        }
      },
      "post": {
        "operationId": "createBranch",
        "summary": "Create a branch. Admin only.",
        "tags": ["Branches"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BranchCreateRequest" } } } },
        "responses": {
          "201": { "description": "Created.", "content": { "application/json": { "schema": { "type": "object", "properties": { "branch": { "$ref": "#/components/schemas/Branch" } } } } } },
          "400": { "description": "Missing code or name.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "403": { "description": "Non-admin caller.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "409": { "description": "Branch code already exists.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } }
        }
      }
    },
    "/branches/{id}": {
      "patch": {
        "operationId": "updateBranch",
        "summary": "Update a branch's editable fields. Code is immutable. Admin only.",
        "tags": ["Branches"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "object", "properties": { "branch": { "$ref": "#/components/schemas/Branch" } } } } } },
          "403": { "description": "Non-admin caller.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "404": { "description": "Branch not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } }
        }
      }
    },
    "/branches/{id}/archive": {
      "post": {
        "operationId": "archiveBranch",
        "summary": "Archive a branch. Blocked if any of its locations have on-hand stock, open transfers, or pending work assignments.",
        "tags": ["Branches"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Archived.", "content": { "application/json": { "schema": { "type": "object", "properties": { "branch": { "$ref": "#/components/schemas/Branch" } } } } } },
          "403": { "description": "Non-admin caller.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "404": { "description": "Branch not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "409": { "description": "Branch has active stock, open transfers, or pending work.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BranchArchiveBlockers" } } } }
        }
      }
    },
    "/items/search": {
      "get": {
        "operationId": "searchItems",
        "summary": "Server-paginated item search (cursor-based). Tested to 5,000+ items (Week 10).",
        "tags": ["Items"],
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Free-text match against item name or code." },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" }, "description": "The previous page's `nextCursor` - never construct this client-side." },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } }
        ],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ItemSearchPage" } } } },
          "400": { "description": "Invalid limit.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } }
        }
      }
    },
    "/items/{itemId}/stock-detail": {
      "get": {
        "operationId": "getStockDetail",
        "summary": "Branch balances, lots, movement history and reconciliation status for one item, from the canonical journal/projection.",
        "tags": ["Items"],
        "parameters": [{ "name": "itemId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StockDetail" } } } },
          "403": { "description": "The item belongs to a different tenant (caught by enforceOperationalCompanyScope before this handler runs)." },
          "404": { "description": "Item not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } }
        }
      }
    },
    "/items/{itemId}/adjust": {
      "post": {
        "operationId": "adjustItemStock",
        "summary": "Guided manual adjustment. Posts through InventoryPostingService with a required client-supplied idempotency key - a retried request returns the original result (200, duplicate: true) instead of posting twice.",
        "tags": ["Items"],
        "parameters": [{ "name": "itemId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdjustRequest" } } } },
        "responses": {
          "201": { "description": "Posted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostMovementResult" } } } },
          "200": { "description": "Duplicate of an already-posted idempotency key - the original result, not a new post.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostMovementResult" } } } },
          "400": { "description": "Missing/invalid locationId, lotId, qtyDelta, reason or idempotencyKey.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "403": { "description": "The item/location belongs to a different tenant." },
          "404": { "description": "Item, location or lot not found for this tenant.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "422": { "description": "Negative-stock policy blocked the adjustment.", "content": { "application/json": { "schema": { "type": "object", "properties": { "message": { "type": "string" }, "code": { "const": "INSUFFICIENT_STOCK" } } } } } }
        }
      }
    },
    "/items/{itemId}/movements/{movementId}/reverse": {
      "post": {
        "operationId": "reverseItemMovement",
        "summary": "Posts an equal-and-opposite movement. The original movement row is never edited. Reversing an already-reversed movement fails (409), and retrying a reversal request is itself idempotent via a derived key.",
        "tags": ["Items"],
        "parameters": [
          { "name": "itemId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "movementId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "reason": { "type": "string" } } } } } },
        "responses": {
          "201": { "description": "Reversed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostMovementResult" } } } },
          "200": { "description": "Duplicate reversal request - the original reversal result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostMovementResult" } } } },
          "404": { "description": "Movement not found for this tenant.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } },
          "409": { "description": "This movement has already been reversed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyErrorMessage" } } } }
        }
      }
    },
    "/imports/staged/batches": {
      "post": {
        "operationId": "createStagedImportBatch",
        "summary": "Stage parsed import rows without changing stock.",
        "tags": ["Imports"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["type", "fileName", "rows"], "properties": { "type": { "type": "string", "enum": ["PURCHASE", "SALES", "SALES_RETURN", "OPENING_STOCK"] }, "fileName": { "type": "string" }, "sourceFormat": { "type": "string" }, "rows": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": true } } } } } } },
        "responses": { "201": { "description": "Batch staged." }, "200": { "description": "Byte-identical duplicate; existing batch returned." }, "400": { "description": "Invalid type or empty rows." } }
      }
    },
    "/imports/staged/batches/{id}": {
      "get": {
        "operationId": "getStagedImportBatch",
        "summary": "Read one tenant-scoped staged import batch.",
        "tags": ["Imports"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Batch status and checkpoint." }, "404": { "description": "Batch not found for this tenant." } }
      }
    },
    "/imports/staged/batches/{id}/validate": {
      "post": {
        "operationId": "validateStagedImportBatch",
        "summary": "Validate every staged row without posting stock.",
        "tags": ["Imports"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Validation summary." }, "404": { "description": "Batch not found." }, "409": { "description": "Invalid batch state." } }
      }
    },
    "/imports/staged/batches/{id}/commit": {
      "post": {
        "operationId": "queueStagedImportCommit",
        "summary": "Queue a validated batch for crash-safe background commit.",
        "tags": ["Imports"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "202": { "description": "Commit queued." }, "404": { "description": "Batch not found." }, "409": { "description": "Invalid batch state." } }
      }
    },
    "/imports/staged/batches/{id}/failures": {
      "get": {
        "operationId": "exportStagedImportFailures",
        "summary": "Export structured row validation failures.",
        "tags": ["Imports"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Flattened row failures." }, "404": { "description": "Batch not found." } }
      }
    },
    "/imports/staged/batches/{id}/reverse": {
      "post": {
        "operationId": "reverseStagedImportBatch",
        "summary": "Reverse committed rows with equal-and-opposite movements.",
        "tags": ["Imports"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "reason": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Batch reversed." }, "404": { "description": "Batch not found." }, "409": { "description": "Invalid batch state." } }
      }
    }
  }
}
