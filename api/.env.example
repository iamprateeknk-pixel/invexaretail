# ===== DATABASE CONFIGURATION =====
# Database connection string (PostgreSQL 14+)
# Format: postgresql://username:password@host:port/database
# Leave this empty for in-memory seed data (local/demo). Set it to persist
# inventory in Postgres. PERSISTENCE_MODE is unused; DATABASE_URL selects the mode.
DATABASE_URL="postgresql://retail:retail_password@postgres:5432/retail_inventory"

# ===== SERVER CONFIGURATION =====
# Server port
PORT=4000

# Environment: development, staging, production
NODE_ENV="development"

# API Base URL
API_BASE_URL="http://localhost:4000"

# Browser origins that may call the API (comma-separated). Set the production
# domain exactly in Hostinger; do not use * when credentials are enabled.
ALLOWED_ORIGINS="https://invexaretail.com,http://localhost:5173"

# Optional deployment identifier, displayed by /health and /ready.
APP_VERSION="local"

# ===== SECURITY =====
# JWT Secret key for token signing (MUST be long and random!)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-to-something-long-and-random"

# JWT token expiration time
JWT_EXPIRY="24h"

# ADR-003: pepper mixed into the OTP code hash before it is persisted.
# Falls back to JWT_SECRET if unset - set it explicitly in production so
# rotating one secret does not silently rotate the other.
OTP_PEPPER=""

# ADR-003: browsers get the refresh token via a Secure HttpOnly cookie AND
# (temporarily) in the login/refresh JSON body, for compatibility with the
# web app until it switches to cookie-only refresh. Native/mobile clients
# always get it in the body regardless of this flag (no cookie jar). Set to
# an ISO date to stop including it in the body for browser requests after
# that date. Leave empty to keep the compatibility path indefinitely.
LEGACY_REFRESH_TOKEN_IN_BODY_UNTIL=""

# Password for seeding demo accounts
SEED_PASSWORD="ChangeMe123!"

# ===== FILE UPLOAD =====
# Directory for file uploads
UPLOAD_DIR="/app/uploads"

# Max file size (in bytes)
MAX_FILE_SIZE="10485760"

# Allowed file types
ALLOWED_FILE_TYPES="pdf,jpg,jpeg,png,doc,docx"

# ===== POSTGRES CONFIGURATION (for Docker setup) =====
# Postgres user
PGUSER="retail"

# Postgres password
PGPASSWORD="retail_password_change_this"

# Postgres database name
PGDATABASE="retail_inventory"

# ===== LOGGING =====
# Log level: error, warn, info, debug
LOG_LEVEL="info"

# ===== RATE LIMITING =====
# Rate limit window (in milliseconds)
RATE_LIMIT_WINDOW=60000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=240

# ALLOWED_ORIGINS above is the active CORS setting used by the API.

# ===== CACHE =====
# Cache TTL (time to live) in seconds
CACHE_TTL=3600

# ===== FEATURES =====
# Enable blind count mode (no book quantity visibility)
ENABLE_BLIND_COUNT=true

# Enable transfer approval workflow
ENABLE_TRANSFER_WORKFLOW=true

# Enable audit logging
ENABLE_AUDIT_LOG=true

# ===== EMAIL (OPTIONAL - OTP sign-in) =====
# When SMTP_HOST is set, send-otp delivers the code over SMTP.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_PASS can be used instead of SMTP_PASSWORD.
# EMAIL_FROM="noreply@retail-inventory.app"

# ===== EXTERNAL SERVICES (OPTIONAL) =====
# AWS S3 for file uploads
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Sentry for error tracking
SENTRY_DSN=""

# ===== DEVELOPMENT ONLY =====
# Print OTP codes to the API console when SMTP is not configured.
# Never enable this in production.
ENABLE_DEV_OTP=true

# Enable API documentation (Swagger)
ENABLE_SWAGGER=true

# Enable request logging
DEBUG="retail:*"

# ===== BILLING (OPTIONAL) =====
# Leave STRIPE_SECRET_KEY empty for Hostinger manual invoicing.
# Set a real sk_test_ / sk_live_ key to create Stripe Checkout sessions.
# Non-production may use sk_test_invexa_local for the local checkout adapter.
# Production ignores the local adapter key and stays manual.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
