# Invexa Retail API — environment contract.
# Single source: docs/PRODUCTION_RUNBOOK.md §2 (Environment contract).
# Set real values in the platform secret store (Railway) — never commit them.
# The API refuses to boot in production with a missing or placeholder secret
# (api/src/lib/production-guard.ts).

# ===== REQUIRED IN PRODUCTION =====
NODE_ENV=production

# Managed PostgreSQL connection string. Production refuses to boot without a
# database; REQUIRE_DATABASE=false is an explicit demo-only opt-out and only
# downgrades the failure to a warning.
DATABASE_URL=postgresql://user:password@host:5432/invexaretail
REQUIRE_DATABASE=true

# 32+ random chars. Missing, a known placeholder, or under 16 chars stops the
# process at boot. Generate with: openssl rand -base64 32
JWT_SECRET=

# Pepper mixed into OTP code hashes (ADR-003). Recommended: set it explicitly
# so rotating JWT_SECRET does not silently rotate OTP hashing. Defaults to
# JWT_SECRET when unset. Must not be a placeholder.
OTP_PEPPER=

# Only needed when seeding. Must not be the repository default — the boot
# guard rejects the well-known default in production.
SEED_PASSWORD=

# Exact web origins allowed to call the API (comma-separated, scheme + host).
# Do not use * — credentials are enabled.
ALLOWED_ORIGINS="https://invexaretail.com"

# HTTP port. Railway sets PORT itself; 4000 is the local/Dockerfile default.
PORT=4000

# ===== SERVICE SPLIT =====
# Schedulers run in the worker service only (api/railway.worker.json).
# Keep RUN_SCHEDULERS=false on the API service.
RUN_SCHEDULERS=false

# Worker: nightly stock reconciliation cadence, in hours (default 24).
RECONCILE_INTERVAL_HOURS=24

# Snapshot reconciliation interval in ms, off the request path (default 30000).
DATABASE_REFRESH_INTERVAL_MS=30000

# ===== OPTIONAL FEATURES =====
# 2FA (TOTP): 32 bytes, base64. Unset = 2FA reported "not configured".
TOTP_ENCRYPTION_KEY=

# Passkeys (WebAuthn): both must be set to enable. RP ID is the web app's
# registrable domain; origins are exact web origins, comma-separated.
# Unset = passkeys reported "not configured" (503).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
# WEBAUTHN_RP_NAME=Invexa Retail

# Per-IP API rate limit per minute (default 240). Raise for a branch behind
# one NAT.
API_RATE_LIMIT_PER_MINUTE=240

# Breach alerts (outbox POISON or stuck >15 min, stock mismatch, stuck
# offline commands): a Slack incoming webhook or any endpoint accepting
# JSON. Runs in the worker. Unset = nothing is sent.
ALERT_WEBHOOK_URL=
ALERT_SWEEP_MINUTES=5

# OpenTelemetry tracing (OTLP/HTTP). Unset = off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=invexa-api
# OTEL_SDK_DISABLED=true

# ===== AUTH COMPATIBILITY =====
# Browsers receive the refresh token in a Secure HttpOnly cookie AND, until
# the date below, in the login/refresh JSON body (web compatibility path).
# Native/mobile clients always receive it in the body. Set an ISO date to
# stop the body path for browsers; leave empty to keep it indefinitely.
LEGACY_REFRESH_TOKEN_IN_BODY_UNTIL=""

# ===== EMAIL (OTP SIGN-IN, OPTIONAL) =====
# When SMTP_HOST is set, send-otp delivers codes over SMTP. Without SMTP,
# OTP sign-in stays disabled (fails closed) outside development.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_PASS can be used instead of SMTP_PASSWORD.
# EMAIL_FROM="noreply@invexaretail.com"

# ===== BILLING (OPTIONAL) =====
# Leave STRIPE_SECRET_KEY empty for manual invoicing. Non-production may use
# the local adapter key (sk_test_invexa_local); production ignores it and
# stays manual.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ===== RELEASE METADATA (SET BY CI / PLATFORM) =====
# Reported by /health, /ready and /meta.
APP_VERSION="local"
GITHUB_SHA=""

# ===== ALTERNATE DATABASE CONFIG (RARELY NEEDED) =====
# If DATABASE_URL is unset, the discrete parts are used instead:
# PGHOST/PGUSER/PGPASSWORD/PGDATABASE/PGPORT (or DB_HOST/DB_USER/
# DB_PASSWORD/DB_NAME/DB_PORT). PG_POOL_MAX caps the Prisma connection
# pool (default 10).
# PG_POOL_MAX=10

# ===== FORBIDDEN IN PRODUCTION =====
# ENABLE_DEV_OTP prints one-time sign-in codes to the API console. It is
# honoured only when NODE_ENV is not production, and the production boot
# guard FAILS the boot if ENABLE_DEV_OTP=true is set on a production
# process. Never set it on a deployed service.
