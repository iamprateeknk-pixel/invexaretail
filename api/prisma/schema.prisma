  @@index([tenantId])


  @@index([purchaseOrderId])
  @@index([itemId])
}

// Blueprint P7 "3-way match: PO vs GRN vs supplier invoice; tolerance and
// exception workflow." A submitted invoice is matched (lib/three-way-match.ts)
// against the PO's lines and their already-tracked receivedQty (the GRN
// side of the match); the result is stored so AP can see exactly which
// lines cleared and which are exceptions, without recomputing it.
// Audit O-4: quantity price breaks. Ordering at least `minQty` of the item from the supplier costs `unitCost` each.
model SupplierPriceBreak {
  id        String   @id @default(cuid())
  supplierId String
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  minQty    Float
  // Money: Decimal, not Float (prohibited pattern #3).
  unitCost  Decimal  @db.Decimal(18, 4)
  companyId String   @default("default-company")
  createdAt DateTime @default(now())

  @@unique([supplierId, itemId, minQty])
  @@index([companyId])
  @@index([supplierId, itemId])
}

model SupplierInvoice {
  id              String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  invoiceNumber   String
  invoiceDate     DateTime?
  totalAmount     Decimal  @default(0) @db.Decimal(14, 2)
  status          String   @default("PENDING")
  matchResult     Json?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String   @default("tenant-invexa")

  lines SupplierInvoiceLine[]

  @@index([purchaseOrderId])
  @@index([tenantId])
}

