// Saved column-mapping templates (blueprint 12.2), e.g. "Logic ERP Sales" /
// "Logic ERP Purchase", so a recurring source file format doesn't need
// manual column mapping on every import.
model ImportTemplate {
  id              String   @id @default(cuid())
  name            String
  importType      String
  columnMapping   Json
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([name, importType])
  @@index([importType])
}

// Transfer with Carton/Packaging Details
model TransferCarton {
  id              String   @id @default(cuid())
  transferId      String
  transfer        Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  cartonNumber    String
  qrCode          String?
  contents        Json?
  quantity        Float
  weight          Float?
  status          String   @default("PACKED")
  photoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])


  @@index([transferId, status])
  @@unique([transferId, cartonNumber])
}

// Feature Configuration
model FeatureFlag {
  id              String   @id @default(cuid())
  name            String   @unique
  enabled         Boolean  @default(false)
  betaMode        Boolean  @default(false)
  readOnly        Boolean  @default(false)
  scope           String   @default("global")
  scopeId         String?
  config          Json?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scope, scopeId, enabled])
}

model WorkflowConfiguration {
  id              String   @id @default(cuid())
  type            String
  scopeId         String?
  requiresApproval Boolean  @default(false)
  varianceThreshold Float?
  negativeStockRule String @default("BLOCK")
  fefoEnforced    Boolean  @default(true)
  expiryBlocking  Boolean  @default(false)
  photoRequired   Boolean  @default(false)
  config          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([type, scopeId])
}

// Durable SaaS control-plane snapshot. Hostinger has no reliable worker, so
// Studio publishes and company locks are stored as one JSON document and
// self-healed by runtime-schema if this migration has not been applied.
model ControlPlaneState {
  id        String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

// Blueprint P8: bin-granularity stock. Location ATP remains on StockLedger
// (item+lot+location); this table answers "Bin A currently holds N units".
model BinStock {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  lotId       String   @default("")
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  binId       String
  onHand      Float    @default(0)
  reserved    Float    @default(0)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([itemId, lotId, locationId, binId])
  @@index([locationId, binId])
}

// Blueprint P4 "WMS 3.0: Bin moves": an explicit bin-to-bin transfer ledger,
// separate from BinStock's current-balance projection, so every scanned
// source -> destination move has an auditable record (who, when, how much).
model BinMovement {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  lotId       String   @default("")
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  fromBinId   String
  toBinId     String
  quantity    Float
  reference   String?
  actorId     String?
  createdAt   DateTime @default(now())

  @@index([locationId, createdAt])
  @@index([itemId])
}

// Blueprint P7 / P11: Amazon/Flipkart/website connectors that POST /orders.
model MarketplaceConnector {
  id             String    @id @default(cuid())
  name           String
  platform       String
  channel        String
  webhookSecret  String
  status         String    @default("ACTIVE")
  tenantId       String    @default("default-company")
  createdAt      DateTime  @default(now())
  lastIngestedAt DateTime?

  @@index([tenantId, status])
  @@index([platform, status])
}

// Blueprint P3 "Traceability 3.0": a true unit-serial model. Serial state
// must reconcile with the stock ledger, never create stock the ledger does
// not own - every status change also posts a SerialMovement row so a
// serial's full history (recall trace) can be reconstructed independent of
// current location.
model SerialNumber {
  id                String    @id @default(cuid())
  itemId            String
  item              Item      @relation(fields: [itemId], references: [id])
  lotId             String?
  lot               Lot?      @relation(fields: [lotId], references: [id])
  serial            String
  // IN_STOCK | RESERVED | SOLD | RETURNED | DAMAGED | LOST
  status            String    @default("IN_STOCK")
  currentLocationId String?
  currentLocation   Location? @relation(fields: [currentLocationId], references: [id])
  currentBinId      String?
  receivedAt        DateTime  @default(now())
  soldAt            DateTime?
  returnState       String?
  warrantyEnd       DateTime?
  metadata          Json?
  companyId         String    @default("default-company")
  tenantId          String    @default("tenant-invexa")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  movements         SerialMovement[]

  @@unique([itemId, serial])
  @@index([currentLocationId, status])
  @@index([companyId])
}

model SerialMovement {
  id             String       @id @default(cuid())
  serialNumberId String
  serialNumber   SerialNumber @relation(fields: [serialNumberId], references: [id])
  // RECEIVE | TRANSFER | PICK | PACK | SALE | RETURN | ADJUSTMENT
  movementType   String
  fromLocationId String?
  toLocationId   String?
  fromStatus     String?
  toStatus       String
  // Ties this movement to the stock ledger/order/transfer transaction that
  // caused it, e.g. a StockMovement id or Order id - not an FK so a serial
  // movement never blocks on the source row's lifecycle.
  reference      String?
  actorId        String?
  createdAt      DateTime     @default(now())

  @@index([serialNumberId, createdAt])
}


// Blueprint v4 §12 / Appendix A: monthly stock-take campaign. FK-free like
// the other rule/result tables (restricted-MySQL hosting); joined in code.
model StockTakeCampaign {
  id                String    @id @default(cuid())
  companyId         String    @default("default-company")
  tenantId          String    @default("tenant-invexa")
  name              String
  locationId        String
  // DRAFT | ACTIVE | COUNTING | IN_REVIEW | COMPLETED | PAUSED | CANCELLED
  status            String    @default("DRAFT")
  dailyItemsPerUser Int
  userIds           Json
  priorityOrder     Json
  includeNewStock   Boolean   @default(true)
  timezone          String    @default("Asia/Kolkata")
  startDate         String
  endDate           String?
  lastRunDate       String?
  pausedFrom        String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  activatedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?

  @@index([companyId, locationId, status])
  @@index([tenantId])
}

model StockTakeCampaignItem {
  campaignId     String
  itemId         String
  // PENDING | ASSIGNED | SUBMITTED | APPROVED | RECOUNT | DISPOSITIONED | EXCLUDED
  status         String    @default("PENDING")
  excludedReason String?
  assignedToId   String?
  assignmentId   String?
  countId        String?
  assignedDate   DateTime?
  lastCountedAt  DateTime?
  recounts       Int       @default(0)
  addedAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@id([campaignId, itemId])
  @@index([campaignId, status])
}
