generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ADMIN_USER
  BRANCH_MANAGER
  STORE_USER
  WAREHOUSE_PICKER
  AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  EXPORT
  ARCHIVE
  REVERSE
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALES_DEDUCTION
  SALES_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_VARIANCE
  ADJUSTMENT
  WASTE
  DAMAGE
  EXPIRY_WRITE_OFF
}

enum ExpiryAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  RESOLVED_BY_TRANSFER
  RESOLVED_BY_WRITE_OFF
}

enum TransferStatus {
  DRAFT
  PENDING_PICK
  REQUESTED
  PICKING
  PARTIAL
  PICKED
  READY_FOR_ADMIN
  CONFIRMED
  DISPATCHED
  IN_TRANSIT
  RECEIVED
  PARTIAL_RECEIVED
  CLOSED
  REJECTED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  SUBMITTED
  CANCELLED
}

// Blueprint Module H (Returns, Damage, Quarantine & Exception Management) /
// section 18 "Exception Inbox": the cross-module case type for every
// unresolved operational problem - damage, short/excess receipt, wrong
// item, expired stock, missing stock (count variance) and QC failure.
enum ExceptionType {
  DAMAGE
  SHORT_RECEIPT
  EXCESS_RECEIPT
  WRONG_ITEM
  EXPIRED
  MISSING_STOCK
  QC_FAIL
  TRANSFER_DISCREPANCY
  COUNT_VARIANCE
  QUARANTINE
}

enum ExceptionStatus {
  OPEN
  IN_PROGRESS
  PENDING_APPROVAL
  RESOLVED
  CLOSED
  REJECTED
}

enum ExceptionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Disposition options per blueprint section 14 (QC/quarantine) and section
// 14 (returns/exceptions): how a case is finally closed.
enum ExceptionDisposition {
  RESTOCK
  VENDOR_RETURN
  MARKDOWN
  DESTROY
  REWORK
  WRITE_OFF
  ACCEPT
  RECOUNT
  ESCALATE
  NONE
}

// Single row (id fixed to "default"), not a multi-tenant table: this is the
// one organization's profile, matching the app's single-tenant design (see
// DEFAULT_COMPANY_ID in src/index.ts). No relations to other tables - other
// models are not scoped by company.
model CompanyProfile {
  id          String   @id @default("default")
  name        String
  email       String?
  phone       String?
  industry    String?
  industryKey String?
  address     String?  @db.Text
  // Audit T-2: IANA business timezone; null = process default.
  timezone    String?
  // Audit C-4: per-company cycle-count cadence override (days between required counts, by ABC
  // class); null = the 7/30/90 default in ABC_CADENCE (lib/abc-cycle-count.ts).
  cycleCountCadenceADays Int?
  cycleCountCadenceBDays Int?
  cycleCountCadenceCDays Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String   @default("tenant-invexa")

  @@index([tenantId])

}

model User {
  totp UserTotp?
  passkeys PasskeyCredential[]
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  status             UserStatus @default(ACTIVE)
  assignedLocations  String   @db.Text
  assignedBranches   String?  @db.Text
  // SaaS company that owns this login. Distinct from Item.company (brand).
  companyId          String   @default("default-company")
  tenantId           String   @default("tenant-invexa")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  otpSecret          String?
  mfaEnabled         Boolean  @default(false)
  suspendedReason    String?

  stockCounts        StockCount[]
  transferRequests   Transfer[]
  assignmentsGiven   CountAssignment[] @relation("CountAssignmentAssignedBy")
  assignmentsOwned   CountAssignment[] @relation("CountAssignmentAssignedTo")
  importBatches      ImportBatch[]
  inventoryMovements InventoryMovement[]
  workAssignments    WorkAssignment[] @relation("WorkAssignmentAssignedTo")
  workAssignmentsCreated WorkAssignment[] @relation("WorkAssignmentCreatedBy")
  userSessions       UserSession[]
  userPermissions    UserPermission[]
  userRoles          UserRole[]
  loginHistory       LoginHistory[]
  workComments       WorkComment[]
  importTemplates    ImportTemplate[]
  exceptionCasesOwned    ExceptionCase[] @relation("ExceptionCaseOwner")
  exceptionCasesReported ExceptionCase[] @relation("ExceptionCaseReportedBy")
  putawayTasks           PutawayTask[]
  pickWavesAssigned      PickWave[] @relation("PickWaveAssignedTo")
  pickWavesCreated       PickWave[] @relation("PickWaveCreatedBy")
  orders                 Order[]
  toleranceRules         ToleranceRule[]
  approvalRules          ApprovalRule[]
  approvalRequestsMade   ApprovalRequest[] @relation("ApprovalRequestRequestedBy")
  approvalRequestsDecided ApprovalRequest[] @relation("ApprovalRequestDecidedBy")
  evidenceRules          EvidenceRule[]
  qcChecklistTemplates   QcChecklistTemplate[]
  qcInspections          QcInspection[]
  intelligenceDismissals IntelligenceDismissal[]

  @@index([companyId])
  @@index([tenantId])
}

model Branch {
  id              String   @id @default(cuid())
  code            String
  name            String
  type            String   @default("WAREHOUSE")
  status          String   @default("ACTIVE")
  companyId       String   @default("default-company")
  tenantId        String   @default("tenant-invexa")
  address         String?  @db.Text
  phone           String?
  email           String?
  managerId       String?
  workingHours    String?
  locations       Location[]
  workAssignments WorkAssignment[]
  exceptionCases  ExceptionCase[]
  toleranceRules  ToleranceRule[]
  approvalRules   ApprovalRule[]
  evidenceRules   EvidenceRule[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code, status])
  @@index([companyId])
  @@index([tenantId])

  @@unique([companyId, code])
}

model Location {
  id                    String   @id @default(cuid())
  code                  String
  name                  String
  type                  String
  locationType          String?  @default("STANDARD")
  branchId              String?
  branch                Branch?  @relation(fields: [branchId], references: [id])
  parentId              String?
  status                String   @default("ACTIVE")
  // Admin-chosen display order in the location switcher; lower first, ties fall back to createdAt.
  sortOrder             Int      @default(0)
  companyId             String   @default("default-company")
  tenantId              String   @default("tenant-invexa")
  description           String?  @db.Text
  latitude              Float?
  longitude             Float?
  deliverySlaHours      Float?
  shippingCostPerKm     Decimal? @db.Decimal(14, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  stock                 StockLedger[]
  stockBalance          StockBalance[]
  counts                StockCount[]
  transfers             Transfer[] @relation("TransferLocation")
  countAssignments      CountAssignment[]
  openingSnapshots      OpeningStockSnapshot[]
  inventoryMovements    InventoryMovement[]
  syncCheckpoints       SyncCheckpoint[]
  workAssignments       WorkAssignment[]
  expiryAlerts          ExpiryAlert[]
  stockMovements        StockMovement[]
  replenishmentSuggestions ReplenishmentSuggestion[]
  exceptionCases        ExceptionCase[]
  bins                  Bin[]
  putawayTasks          PutawayTask[]
  pickWaves             PickWave[]
  orders                Order[]
  qcInspections         QcInspection[]
  intelligenceDismissals IntelligenceDismissal[]
  binStocks             BinStock[]
  serialNumbers         SerialNumber[]
  binMovements          BinMovement[]

  @@index([code, branchId, status])
  @@index([companyId])
  @@index([tenantId])

  // Audit P0-3: identity is per company. `code` used to be globally unique, so two
  // customers could not both have a location (or SKU, or branch) with the same code.
  @@unique([companyId, code])
}

// Blueprint Module B / section 6 (Location/WMS): warehouse -> zone -> aisle
// -> rack -> shelf -> bin. Deliberately structural for this pass - a bin is
// where received stock is physically placed, not a separate StockLedger
// location (that finer-grained ledger is the blueprint's later Warehouse OS
// phase). Putaway confirmation below records which bin holds what, giving
// guided putaway and pick-path data without re-keying the existing ledger.
model Bin {
  id            String   @id @default(cuid())
  locationId    String
  location      Location @relation(fields: [locationId], references: [id])
  code          String
  zone          String?
  aisle         String?
  rack          String?
  shelf         String?
  capacity      Float?
  storageClass  String?
  status        String   @default("ACTIVE")
  // Blueprint P4 "Internal replenishment": pick-face vs reserve storage.
  // A pick-face bin is where pickers actually pick from; reserve bins back
  // it up. min/max drive when a reserve-to-pick-face task is suggested.
  isPickFace    Boolean  @default(false)
  pickFaceMin   Float?
  pickFaceMax   Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  putawaySuggested PutawayTask[] @relation("PutawaySuggestedBin")
  putawayConfirmed PutawayTask[] @relation("PutawayConfirmedBin")
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])


  @@unique([locationId, code])
  @@index([locationId, status])
}

// Blueprint Module B / section 8.3 (Putaway): system suggests a bin for
// received stock; a picker scans/confirms the actual bin. Wrong-bin scans
// are out of scope for this pass (no mobile scan client yet) - this models
// the task and its suggested-vs-confirmed bin so that flow can be added
// without another schema change.
model PutawayTask {
  id              String    @id @default(cuid())
  itemId          String
  item            Item      @relation(fields: [itemId], references: [id])
  lotId           String?
  lot             Lot?      @relation(fields: [lotId], references: [id])
  locationId      String
  location        Location  @relation(fields: [locationId], references: [id])
  quantity        Float
  suggestedBinId  String?
  suggestedBin    Bin?      @relation("PutawaySuggestedBin", fields: [suggestedBinId], references: [id])
  confirmedBinId  String?
  confirmedBin    Bin?      @relation("PutawayConfirmedBin", fields: [confirmedBinId], references: [id])
  status          String    @default("PENDING")
  sourceDocument  String?
  sourceLineId    String?
  assignedToId    String?
  assignedTo      User?     @relation(fields: [assignedToId], references: [id])
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])


  @@index([locationId, status])
  @@index([status])
}

// Blueprint Module C / section 9.2 (Transfer & Warehouse OS - pick waves):
// "Pick wave can combine multiple store transfers while keeping destination
// segregation." Transfers themselves are unchanged (still picked and
// received one at a time through the existing per-transfer flow); a wave
// is a planning/sequencing layer that groups several source-location
// transfers so a picker walks the warehouse once, in bin order, instead of
// re-walking it per transfer. transferIds is a loose id list (not a
// relation table) since Transfer already has its own lifecycle and audit
// trail - the wave only needs to remember which ones it grouped.
model PickWave {
  id           String    @id @default(cuid())
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  status       String    @default("OPEN")
  transferIds  Json
  assignedToId String?
  assignedTo   User?     @relation("PickWaveAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User      @relation("PickWaveCreatedBy", fields: [createdById], references: [id])
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])


  @@index([locationId, status])
}

// Blueprint Module G / section 13.3 (OMS & Allocation) - starter scope for
// P7. "Available-to-Promise... should prevent the same unit being promised
// by website, marketplace and store simultaneously": an Order reserves
// stock through the exact same lib/reservation.ts mechanism a transfer
// request does, against the same StockLedger.reserved counter, so the two
// channels genuinely compete for the same pool instead of each tracking
// its own. Routing rules, split fulfilment, backorder and marketplace
// connectors are deliberately out of scope here - fulfillmentLocationId is
// chosen by the caller, not routed automatically.
model Order {
  id                    String    @id @default(cuid())
  channel               String
  externalReference     String?
  status                String    @default("PENDING")
  fulfillmentLocationId String
  fulfillmentLocation   Location  @relation(fields: [fulfillmentLocationId], references: [id])
  customerName          String?
  notes                 String?   @db.Text
  createdById           String
  createdBy             User      @relation(fields: [createdById], references: [id])
  reservedAt            DateTime?
  reservationExpiresAt  DateTime?
  fulfilledAt           DateTime?
  cancelledAt           DateTime?
  expiredAt             DateTime?
  // Blueprint P5 "Promise engine": deterministic estimate set at
  // reservation time (lib/promise-engine.ts) - pick/pack lead + per-channel
  // safety buffer for dispatch, plus the fulfillment location's delivery
  // SLA for delivery when known.
  estimatedDispatchAt   DateTime?
  estimatedDeliveryAt   DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lines OrderLine[]
  packSessions PackSession[]
  shipments    Shipment[]
  returnRequests ReturnRequest[]
  tenantId    String   @default("tenant-invexa")
  // Week 19: real per-company scoping, the second slice of the migration
  // Week 17 started for PurchaseOrder. Backfilled from the order's own
  // fulfillmentLocation.companyId.
  companyId   String   @default("default-company")
  @@index([tenantId])
  @@index([companyId])


  @@index([status, createdAt])
  @@unique([channel, externalReference])
  @@index([channel, status])
  @@index([fulfillmentLocationId, status])
  @@index([status, reservationExpiresAt])
}

// Blueprint P5 "Packing station: scan order/tote -> verify items ->
// cartonize -> weight/dimensions -> seal -> print pack slip/label." A pack
// session is additive tracking on top of the existing reservation/fulfil
// flow - it never changes Order.status itself, so it cannot desync the
// stock-truth invariant those already enforce.
model PackSession {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id])
  status       String       @default("IN_PROGRESS")
  cartonCount  Int?
  weightKg     Float?
  lengthCm     Float?
  widthCm      Float?
  heightCm     Float?
  packedById   String
  sealedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  companyId    String       @default("default-company")
  tenantId     String       @default("tenant-invexa")

  lines PackedLine[]

  @@index([orderId, status])
  @@index([companyId])
}

model PackedLine {
  id            String      @id @default(cuid())
  packSessionId String
  packSession   PackSession @relation(fields: [packSessionId], references: [id])
  itemId        String
  lotId         String?
  quantity      Float
  scannedById   String
  scannedAt     DateTime    @default(now())

  @@index([packSessionId])
}

// Blueprint "Returns/RMA: a formal customer-return/RMA/inspection flow" -
// state machine in lib/returns-rma.ts. Additive on top of Order/OrderLine,
// same as PackSession/Shipment: never changes Order.status or the ledger
// directly. A RECEIVED return with a RESTOCK-disposition line is the only
// thing that posts stock back onto the ledger, and only then.
model ReturnRequest {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  status        String   @default("REQUESTED")
  reason        String?
  createdById   String
  // Blueprint v4 §24: PENDING until finance decides; REFUNDED / DENIED afterwards.
  refundStatus  String   @default("PENDING")
  refundNote    String?  @db.Text
  refundedAt    DateTime?
  refundedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  companyId     String   @default("default-company")
  tenantId      String   @default("tenant-invexa")

  lines ReturnLine[]

  @@index([orderId, status])
  @@index([companyId])
}

model ReturnLine {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id])
  orderLineId     String
  orderLine       OrderLine     @relation(fields: [orderLineId], references: [id])
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  quantity        Float
  disposition     String?
  createdAt       DateTime      @default(now())

  @@index([returnRequestId])
  @@index([orderLineId])
}

// Blueprint P5/P6 "Carrier adapter": one shipment per booked AWB, behind
// whichever CarrierAdapter (lib/carrier-adapter.ts) booked it. Additive -
// never changes Order.status; shipping state lives here so a future
// "Shipped"/"Delivered" order view reads it without touching the
// reservation/fulfilment invariants.
model Shipment {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  packSessionId   String?
  carrierProvider String
  awbNumber       String
  serviceCode     String
  status          String    @default("BOOKED")
  labelUrl        String?
  manifestId      String?
  weightKg        Float?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  companyId       String    @default("default-company")
  tenantId        String    @default("tenant-invexa")

  @@unique([awbNumber])
  @@index([orderId])
  @@index([companyId])
}

model OrderLine {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  lotId        String?
  lot          Lot?     @relation(fields: [lotId], references: [id])
  requestedQty Float
  fulfilledQty Float    @default(0)
  fulfillmentLocationId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])

  returnLines ReturnLine[]

  @@index([orderId])
}

// Blueprint Module D / section 10.2 (Count & Audit 2.0): "Tolerance can
// vary by category, value, UOM and branch" and "High-value or repeated-
// variance items automatically require recount by another user." A rule
// only ever produces a *recommendation* attached to a pending count for
// the human reviewer to see - never an automatic status change - matching
// the Exception Inbox / putaway pattern of "recommend, let a human accept
// or dismiss" already used elsewhere in this app. `category`/`branchId`
// null means "applies to every category/branch"; the most specific
// matching active rule wins.
model ToleranceRule {
  id               String   @id @default(cuid())
  label            String
  category         String?
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id])
  valueThreshold   Decimal? @db.Decimal(14, 2)
  percentThreshold Float?
  active           Boolean  @default(true)
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, category])
  @@index([branchId, active])
}

// Blueprint section 16.2 (Workflow Builder): "transfer > ₹1 lakh -> regional
// manager approval" and "manual stock adjustment -> dual control for
// high-value category." Unlike ToleranceRule (a recommendation the
// reviewer can still override), an ApprovalRule genuinely *gates* the
// action - the triggering endpoint blocks until a user meeting
// requiredApproverRole decides. triggerType is a free string
// ("TRANSFER_CONFIRM" and "STOCK_ADJUSTMENT" are wired up) rather than an
// enum, so a later trigger type does not need another migration.
// category/branchId null means "applies to everything" - same
// most-specific-wins matching shape as ToleranceRule.
model ApprovalRule {
  id                   String   @id @default(cuid())
  label                String
  triggerType          String
  category             String?
  branchId             String?
  branch               Branch?  @relation(fields: [branchId], references: [id])
  valueThreshold       Decimal @db.Decimal(14, 2)
  requiredApproverRole String
  active               Boolean  @default(true)
  createdById          String
  createdBy            User     @relation(fields: [createdById], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  approvalRequests ApprovalRequest[]

  @@index([triggerType, active])
  @@index([branchId, active])
}

// Blueprint section 16.2, third named workflow example: "damaged receipt >
// threshold -> photo mandatory." Unlike ToleranceRule (recommend) and
// ApprovalRule (gate on a human decision), this gates on a fact that must
// already exist: at least one evidence photo already uploaded for the
// transfer before the receipt can be posted.
model EvidenceRule {
  id                String   @id @default(cuid())
  label             String
  triggerType       String
  category          String?
  branchId          String?
  branch            Branch?  @relation(fields: [branchId], references: [id])
  quantityThreshold Float?
  valueThreshold    Decimal? @db.Decimal(14, 2)
  active            Boolean  @default(true)
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([triggerType, active])
  @@index([branchId, active])
}

// One gate instance: the triggering action is blocked from `PENDING` until
// a sufficiently-privileged user decides. entityType/entityId identify the
// blocked record (e.g. "Transfer"/<transferId>) generically so future
// trigger types do not need their own request table.
model ApprovalRequest {
  id             String    @id @default(cuid())
  ruleId         String
  rule           ApprovalRule @relation(fields: [ruleId], references: [id])
  triggerType    String
  entityType     String
  entityId       String
  // Decimal migration pilot (docs/decimal-migration-plan.md): write-only in
  // application code (never used in arithmetic - checkApprovalGate compares
  // the plain-number `value` argument against ApprovalRule.valueThreshold,
  // which stays Float for now), so this is the safest first field to convert.
  valueAtStake   Decimal   @db.Decimal(14, 2)
  status         String    @default("PENDING")
  requestedById  String
  requestedBy    User      @relation("ApprovalRequestRequestedBy", fields: [requestedById], references: [id])
  decidedById    String?
  decidedBy      User?     @relation("ApprovalRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNotes  String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([entityType, entityId, status])
  @@index([status, triggerType])
}

model Item {
  id          String   @id @default(cuid())
  // Virtual bundles/kits: this item as a bundle, and as a component of others.
  bundleComponents  ItemBundleComponent[] @relation("BundleParent")
  usedInBundles     ItemBundleComponent[] @relation("BundleComponent")
  code        String
  name        String
  category    String?
  subcategory String?
  company     String?
  // SaaS tenant. Item.company above is the brand/manufacturer name.
  companyId   String   @default("default-company")
  tenantId    String   @default("tenant-invexa")
  unit        String?
  description String?  @db.Text
  // Blueprint v4 §6 "Operations" field group. countMethod: LOT_SCAN (scan a
  // lot barcode, count in whole units) | ITEM_WEIGHT (enter a decimal
  // quantity, server allocates FIFO/FEFO across lots - see
  // lib/warehouse-workflow.ts allocateFefo/allocateLots). pickMethod
  // mirrors the same choice for picking. allocationStrategy is which of
  // FIFO/FEFO the allocator applies when this item is counted/picked by
  // weight instead of lot scan. decimalQuantity flags a loose/KG-style item
  // whose quantities are entered as a decimal rather than a scan-counted
  // whole number. Defaults preserve today's de facto behavior (scan-and-
  // increment, whole units) for every existing item.
  countMethod       String  @default("LOT_SCAN")
  pickMethod        String  @default("LOT_SCAN")
  allocationStrategy String @default("FEFO")
  lotRequired       Boolean @default(true)
  expiryRequired    Boolean @default(false)
  decimalQuantity   Boolean @default(false)
  // Blueprint v4 §6 canonical Item Master. status ACTIVE | INACTIVE |
  // ARCHIVED: anything but ACTIVE is hidden from operational users and
  // blocked from new transactions, but history stays explainable. Permanent
  // delete is only allowed with no history (see lib/item-master.ts).
  status            String    @default("ACTIVE")
  archiveReason     String?
  archivedAt        DateTime?
  archivedById      String?
  barcode           String?
  hsn               String?
  gstRate           Float?
  // Decimal migration slice 6 (docs/decimal-migration-plan.md): money, Decimal(14,2).
  mrp               Decimal?          @db.Decimal(14, 2)
  leadTimeDays      Int?
  shelfLifeDays     Int?
  // ERP aliases / alternate names and codes used to resolve import rows.
  aliases           Json?
  version           Int       @default(1)
  createdById       String?
  updatedById       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lots                    Lot[]
  stock                   StockLedger[]
  stockBalance            StockBalance[]
  counts                  StockCount[]
  transferLines           TransferLine[]
