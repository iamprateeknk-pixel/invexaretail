model ImportBatch {
  id                   String   @id
  type                 String
  fileName             String
  sourceFormat         String
  importedById         String
  importedBy           User     @relation(fields: [importedById], references: [id])
  importedAt           DateTime @default(now())
  totalRows            Int
  validRows            Int
  invalidRows          Int
  duplicateRows        Int      @default(0)
  metadata             Json?
  // Batches created by the existing single-step import flows (persistence.ts)
  // post their stock movements in the same transaction as this row, so they
  // are already POSTED by the time this record exists. New Import Center
  // flows (blueprint 12.1) can create a batch as DRAFT and progress it
  // through the lifecycle explicitly before posting.
  status               String   @default("POSTED")
  branchId             String?
  fileHash             String?
  sourceDateFrom       DateTime?
  sourceDateTo         DateTime?
  openingSnapshots     OpeningStockSnapshot[]
  inventoryMovements   InventoryMovement[]
  rows                 ImportRow[]
  tenantId    String   @default("tenant-invexa")
  // Week 11: the new DRAFT -> VALIDATED -> QUEUED_FOR_COMMIT -> COMMITTING
  // -> COMMITTED/PARTIALLY_COMMITTED/FAILED -> REVERSED lifecycle
  // (lib/import-commit-service.ts) needs the real per-tenant column - the
  // pre-existing `tenantId` above is a single constant across the whole
  // app, not the SaaS company boundary ADR-002 scopes everything else by.
  // Every ImportBatch/ImportRow before this week had no companyId at all.
  companyId            String   @default("default-company")
  // Durable resume point for the batched commit worker: the highest
  // ImportRow.rowNumber successfully committed so far. A crash/restart
  // resumes from here instead of restarting (re-posting already-committed
  // rows) or losing progress.
  checkpointRowNumber  Int      @default(0)
  // ALL_OR_NOTHING | PARTIAL_SUCCESS - decided per import `type`, not per
  // batch (see lib/import-business-rules.ts's IMPORT_TYPE_POLICY), but
  // stored on the batch so a change to the policy table later never
  // reinterprets an already-committed batch's semantics retroactively.
  commitPolicy         String   @default("PARTIAL_SUCCESS")
  reversedAt           DateTime?
  @@index([tenantId])
  @@index([companyId])


  @@index([type, importedAt])
  @@index([importedById, importedAt])
  @@index([status])
  @@index([branchId, fileHash])
}

