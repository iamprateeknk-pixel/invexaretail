  @@index([supplierInvoiceId])
}

// Blueprint P9 "Retail pricing: MRP, retail, wholesale, institutional, web,
// marketplace, branch, customer group, promotional price" +
// "Guardrails: block/warn below landed cost, below minimum margin, above
// MRP, invalid effective date" (lib/price-guardrails.ts). branchId null
// means company-wide; the most branch-specific, currently-effective entry
// wins when resolving a price.
