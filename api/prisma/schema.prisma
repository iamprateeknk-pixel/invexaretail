  responseCode   Int?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  // Blueprint P6 "Sync journal" (payload hash, next retry) + "dead-letter
  // queue, replay safely" (stored body so a replay resends byte-identical).
  payloadHash    String?
  nextRetryAt    DateTime?
  body           String?   @db.Text
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])
  companyId      String    @default("default-company")
