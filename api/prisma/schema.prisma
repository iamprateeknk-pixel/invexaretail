model PurchaseOrder {
  id          String   @id @default(cuid())
  number      String
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  locationId  String
  createdById String
  status      String   @default("DRAFT")
  expectedAt  DateTime?
  // Blueprint v4 §22 lifecycle stamps (Draft -> Approval -> Send -> Receive -> Close).
  approvedAt   DateTime?
  approvedById String?
  sentAt       DateTime?
  closedAt     DateTime?
  closeNote    String?  @db.Text
  notes       String?  @db.Text
  totalAmount Decimal  @default(0) @db.Decimal(14, 2)
  // Blueprint P7 "Landed cost": extra charges allocated across the PO's
  // lines on receipt (lib/landed-cost.ts), so each received lot's cost
  // attributes carry the true landed cost, not just the PO unit price.
  freightCost   Decimal? @default(0) @db.Decimal(14, 2)
  customsCost   Decimal? @default(0) @db.Decimal(14, 2)
  insuranceCost Decimal? @default(0) @db.Decimal(14, 2)
  handlingCost  Decimal? @default(0) @db.Decimal(14, 2)
  landedCostMethod String? @default("VALUE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lines       PurchaseOrderLine[]
  supplierInvoices SupplierInvoice[]
  tenantId    String   @default("tenant-invexa")
  // Week 17: real per-company scoping, added alongside ImportBatch (Week
  // 11) and ExceptionCase (Week 12) - the same class of fix, this time for
  // PurchaseOrder. Backfilled from the order's own Location.companyId.
  companyId   String   @default("default-company")
  @@index([tenantId])
  @@index([companyId])

  @@index([locationId, status])
  @@index([supplierId])

  // Audit T-1: document numbers are unique per company, not across all tenants.
  @@unique([companyId, number])
}

