model Lot {
  id         String   @id @default(cuid())
  lotNo      String
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  expiryDate DateTime?
  // Audit S-1: when the lot was made; with the expiry date it gives the total shelf life for RSL rules.
  manufacturedAt DateTime?
  // AVAILABLE | EXPIRED | BLOCKED | QUARANTINE (blueprint section 17): a
  // lot in any state other than AVAILABLE is excluded from normal FEFO/FIFO
  // allocation and can only be drawn from via an authorized manual override.
  status     String   @default("AVAILABLE")
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stock                   StockLedger[]
  stockBalance            StockBalance[]
  counts                  StockCount[]
  transfers               TransferLine[]
  openingSnapshots        OpeningStockSnapshot[]
  inventoryMovements      InventoryMovement[]
  stockMovements          StockMovement[]
  expiryAlerts            ExpiryAlert[]
  exceptionCases          ExceptionCase[]
  putawayTasks            PutawayTask[]
  orderLines              OrderLine[]
  qcInspections           QcInspection[]
  serialNumbers           SerialNumber[]
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])


  @@unique([itemId, lotNo])
  @@index([expiryDate])
}

model StockLedger {
  id             String   @id @default(cuid())
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id])
  lotId          String
  lot            Lot      @relation(fields: [lotId], references: [id])
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  onHand         Decimal    @default(0) @db.Decimal(18, 3)
  reserved       Decimal    @default(0) @db.Decimal(18, 3)
  inTransit      Decimal    @default(0) @db.Decimal(18, 3)
  // Blueprint section 7.2 inventory state model: physical stock that is on
  // hand but not sellable. Quarantine = received/counted but blocked
  // pending a QC/exception disposition (Exception Inbox); Damaged = the
  // portion of quarantine already confirmed unsellable and awaiting
  // write-off/vendor-return. Neither bucket is part of `onHand` availability
  // math done elsewhere - they are tracked here so quarantined stock is
  // visible instead of silently vanishing from the ledger.
  quarantine     Decimal    @default(0) @db.Decimal(18, 3)
  damaged        Decimal    @default(0) @db.Decimal(18, 3)
  version        Int      @default(0)
  lastUpdatedAt  DateTime @updatedAt
  tenantId    String   @default("tenant-invexa")
  companyId      String   @default("default-company")
  @@index([tenantId])
  @@index([companyId])

  @@unique([itemId, lotId, locationId])
  @@index([locationId, itemId])
}

model StockCount {
  id              String   @id @default(cuid())
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id])
  lotId           String
  lot             Lot      @relation(fields: [lotId], references: [id])
  locationId      String
  location        Location @relation(fields: [locationId], references: [id])
  physicalQty     Float
  bookQty         Float    @default(0)
  mode            String   @default("manual")
  submittedById   String
  submittedBy     User     @relation(fields: [submittedById], references: [id])
  countDate       DateTime @default(now())
  approvedById    String?
  approvedAt      DateTime?
  reviewStatus    String   @default("PENDING_REVIEW")
  reviewReason    String?  @db.Text
  // Audit C-3: root-cause code chosen at review (see lib/count-reason-codes.ts).
  reasonCode      String?
  parentCountId   String?
  // Blueprint v4 §14: sales/purchase files imported after a count can carry
  // movements dated before it, changing what the book quantity should have
  // been. Instead of silently rewriting history the count is flagged;
  // a still-pending count has its book quantity recomputed (bookQtyOriginal
  // keeps what was first recorded).
  // Blueprint v4 §38: client-generated idempotency key. A retried submit
  // (offline outbox, timeout) returns the count it already created instead of
  // creating another. Weight counts share one key across their lot counts.
  requestId       String?
  reconciliationRequired Boolean   @default(false)
  reconciliationNote     String?   @db.Text
  reconciliationAt       DateTime?
  bookQtyOriginal        Float?
  lateDelta              Float     @default(0)
  lateMovementKeys       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId    String   @default("tenant-invexa")
  // Real per-company scoping, the fourth slice of the migration Weeks
  // 17/19 started for PurchaseOrder/Order/Transfer. Backfilled from the
  // count's own Location.
  companyId   String   @default("default-company")

  @@index([tenantId])
  @@index([companyId])
  @@index([reconciliationRequired])
  @@index([submittedById, requestId])

}

/// Admin assigns an item to a Store User to count at a location. Blind by
/// construction: the assignment never carries a book quantity. Fulfilled by
/// linking to the StockCount the Store User eventually submits against it.
model CountAssignment {
  id             String   @id @default(cuid())
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id])
  assignedToId   String
  assignedTo     User     @relation("CountAssignmentAssignedTo", fields: [assignedToId], references: [id])
  assignedById   String
  assignedBy     User     @relation("CountAssignmentAssignedBy", fields: [assignedById], references: [id])
  countDate      DateTime @default(now())
  dueDate        DateTime?
  priority       String   @default("NORMAL")
  instructions   String?  @db.Text
  status         AssignmentStatus @default(ASSIGNED)
  countId        String?  @unique
  parentCountId  String?
  // Set when a stock-take campaign's daily allocation created this task
  // (blueprint v4 §12); recounts inherit it so the campaign tracks coverage.
  campaignId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])
  @@index([campaignId])

  @@index([assignedToId, status])
}

model Transfer {
  id                    String        @id @default(cuid())
  sourceLocationId      String
  sourceLocation        Location      @relation("TransferLocation", fields: [sourceLocationId], references: [id])
  destinationLocationId  String
  status                TransferStatus @default(REQUESTED)
  requestedById         String
  requestedBy           User          @relation(fields: [requestedById], references: [id])
  notes                 String?       @db.Text
  cartonCount           Int?
  // Blueprint v4 §16/§17: packing completion and dispatch details
  // ({ packing: {...}, dispatch: {...} }) - see lib/transfer-packing.ts.
  logistics             Json?
  // The WAREHOUSE_PICKER an admin/branch manager handed this transfer to. Null means
  // any picker at the source location may pick it (the behaviour before assignment existed).
  // No FK, like ExceptionCase owners in memory mode: the route validates the user.
  assignedPickerId      String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  lines                 TransferLine[]
  cartons               TransferCarton[]
  tenantId    String   @default("tenant-invexa")
  // Real per-company scoping, the third slice of the migration Weeks 17/19
  // started for PurchaseOrder/Order. Backfilled from the transfer's own
  // sourceLocation.companyId (the location that authorized the transfer
  // out, the more natural tenant owner than the destination).
  companyId   String   @default("default-company")
  @@index([tenantId])
  @@index([companyId])
  @@index([destinationLocationId, status])
  @@index([sourceLocationId, createdAt])
  @@index([assignedPickerId, status])
}

model TransferLine {
  id            String   @id @default(cuid())
