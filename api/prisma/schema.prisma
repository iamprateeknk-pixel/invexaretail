  @@index([createdAt])
}

// Universal Work/Assignment Engine
model WorkAssignment {
  id              String   @id @default(cuid())
  type            String
  reference       String?
  title           String
  description     String?  @db.Text
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  assignedToId    String
  assignedTo      User     @relation("WorkAssignmentAssignedTo", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User     @relation("WorkAssignmentCreatedBy", fields: [createdById], references: [id])
  status          String   @default("ASSIGNED")
  priority        String   @default("NORMAL")
  dueAt           DateTime?
  slaMinutes      Int?
  instructions    String?  @db.Text
  checklist       Json?
  progress        Int      @default(0)
  startedAt       DateTime?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  closedAt        DateTime?
  items           Json?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workComments    WorkComment[]
  workAttachments WorkAttachment[]

  @@index([assignedToId, status])
  @@index([type, status])
  @@index([dueAt, status])
}

model WorkComment {
  id              String   @id @default(cuid())
  workAssignmentId String
  workAssignment  WorkAssignment @relation(fields: [workAssignmentId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  body            String   @db.Text
  mentions        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workAssignmentId, createdAt])
}

model WorkAttachment {
  id              String   @id @default(cuid())
  workAssignmentId String
  workAssignment  WorkAssignment @relation(fields: [workAssignmentId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String   @db.Text
  fileType        String
  fileSize        Int
  uploadedAt      DateTime @default(now())

  @@index([workAssignmentId])
}

// Exception Inbox (blueprint Module H + section 18): one cross-module inbox
// for unresolved operational problems - damage, short/excess receipt,
// wrong item, expired stock, missing stock and QC failures. Each case has
// an owner, priority, SLA (dueAt), evidence/discussion (via ContextComment
// keyed by entityType "exception"), and a defined closure disposition.
model ExceptionCase {
  id              String   @id @default(cuid())
  type            ExceptionType
  status          ExceptionStatus @default(OPEN)
  priority        ExceptionPriority @default(MEDIUM)
  title           String
  description     String?  @db.Text
  itemId          String?
  item            Item?    @relation(fields: [itemId], references: [id])
  lotId           String?
  lot             Lot?     @relation(fields: [lotId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  quantity        Float?
  valueAtRisk     Float?
  sourceDocument  String?
  sourceLineId    String?
  ownerId         String?
  owner           User?    @relation("ExceptionCaseOwner", fields: [ownerId], references: [id])
  reportedById    String
  reportedBy      User     @relation("ExceptionCaseReportedBy", fields: [reportedById], references: [id])
  dueAt           DateTime?
  disposition     ExceptionDisposition?
  resolutionNotes String?  @db.Text
  resolvedAt      DateTime?
  closedAt        DateTime?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])


  @@index([status, priority, dueAt])
  @@index([type, status])
  @@index([ownerId, status])
  @@index([locationId, status])
  @@index([sourceDocument, sourceLineId])

  qcInspections QcInspection[]
}

// Blueprint §8.2 (Quality Control): "seal/packaging/weight/moisture/
// expiry-window checks" as a formal checklist, replacing a free-text
// ExceptionCase description with a structured, itemized result. A template
// is scoped by category (nullable = applies to every category, same
// most-specific-wins convention as ToleranceRule/EvidenceRule) and lists
// the checks it requires; `checks` is a JSON array of {key, label} so the
// checklist itself is configurable per category without a schema change.
model QcChecklistTemplate {
  id          String   @id @default(cuid())
  label       String
  category    String?
  checks      Json
  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inspections QcInspection[]

  @@index([active, category])
}

// One filled-in checklist against a specific item/lot/location, usually at
// receiving or putaway. `results` is a JSON map of check key -> 'PASS' |
// 'FAIL' | 'NA'; `overallResult` is FAIL if any check failed, computed by
// the same pure function the checklist form itself uses (qc-inspection.ts)
// so the UI and the server never disagree. A FAIL opens a QC_FAIL
// ExceptionCase automatically - the inspection becomes that case's
// structured evidence instead of a reporter's free-text description.
model QcInspection {
  id              String    @id @default(cuid())
  templateId      String
  template        QcChecklistTemplate @relation(fields: [templateId], references: [id])
  itemId          String?
  item            Item?     @relation(fields: [itemId], references: [id])
  lotId           String?
  lot             Lot?      @relation(fields: [lotId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  sourceDocument  String?
  sourceLineId    String?
  results         Json
  overallResult   String
  notes           String?   @db.Text
  inspectedById   String
  inspectedBy     User      @relation(fields: [inspectedById], references: [id])
  exceptionCaseId String?
  exceptionCase   ExceptionCase? @relation(fields: [exceptionCaseId], references: [id])
  createdAt       DateTime  @default(now())
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])


  @@index([sourceDocument, sourceLineId])
  @@index([overallResult, createdAt])
}

// Blueprint §17.1 (Intelligence Action Center): "Transfer 24 PCS", "Create
// PO" and count-variance anomalies already have one-click accept actions
// (POST /replenishment-actions/transfer, the purchase-order draft flow);
// this model gives the other half of "accept/edit/dismiss with an audit
// trail" - a dismissal, which the accept actions above already get for
// free from their own real records (a created Transfer/PurchaseOrder *is*
// the audit trail for an accepted recommendation). FK-free for the same
// restricted-MySQL reason as the other rule/result tables in this app.
// Time-bounded rather than permanent: a dismissed item resurfaces after 24h
// if it is genuinely still under target, matching normal reorder cadence,
// rather than a stale dismissal silently hiding a recommendation forever.
model IntelligenceDismissal {
  id            String   @id @default(cuid())
  locationId    String
  location      Location @relation(fields: [locationId], references: [id])
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  type          String
  countId       String?
  reason        String?
  dismissedById String
  dismissedBy   User     @relation(fields: [dismissedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([locationId, itemId, type, createdAt])
}

// Expiry Management
model ExpiryAlert {
  id              String   @id @default(cuid())
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id])
  lotId           String
  lot             Lot      @relation(fields: [lotId], references: [id])
  locationId      String
  location        Location @relation(fields: [locationId], references: [id])
  quantity        Float
  value           Float?
  expiryDate      DateTime
  daysUntilExpiry Int
  status          ExpiryAlertStatus @default(ACTIVE)
  recommendedAction String?
  metadata        Json?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId    String   @default("tenant-invexa")
  @@index([tenantId])


  @@index([status, locationId, expiryDate])
  @@index([itemId, expiryDate])
}

// Replenishment Engine
model ReplenishmentSuggestion {
  id              String   @id @default(cuid())
