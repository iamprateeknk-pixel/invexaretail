  binId       String
  onHand      Decimal    @default(0) @db.Decimal(18, 3)
  reserved    Decimal    @default(0) @db.Decimal(18, 3)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([itemId, lotId, locationId, binId])
  @@index([locationId, binId])
}

// Blueprint P4 "WMS 3.0: Bin moves": an explicit bin-to-bin transfer ledger,
// separate from BinStock's current-balance projection, so every scanned
// source -> destination move has an auditable record (who, when, how much).
model BinMovement {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  lotId       String   @default("")
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  fromBinId   String
  toBinId     String
  quantity    Decimal @db.Decimal(18, 3)
  reference   String?
  actorId     String?
  createdAt   DateTime @default(now())

  @@index([locationId, createdAt])
  @@index([itemId])
}

// Blueprint P7 / P11: Amazon/Flipkart/website connectors that POST /orders.
model MarketplaceConnector {
  id             String    @id @default(cuid())
  name           String
  platform       String
  channel        String
  webhookSecret  String
  status         String    @default("ACTIVE")
  tenantId       String    @default("default-company")
  createdAt      DateTime  @default(now())
  lastIngestedAt DateTime?

  @@index([tenantId, status])
  @@index([platform, status])
}

// Blueprint P3 "Traceability 3.0": a true unit-serial model. Serial state
// must reconcile with the stock ledger, never create stock the ledger does
// not own - every status change also posts a SerialMovement row so a
// serial's full history (recall trace) can be reconstructed independent of
// current location.
model SerialNumber {
  id                String    @id @default(cuid())
  itemId            String
  item              Item      @relation(fields: [itemId], references: [id])
  lotId             String?
  lot               Lot?      @relation(fields: [lotId], references: [id])
  serial            String
  // IN_STOCK | RESERVED | SOLD | RETURNED | DAMAGED | LOST
  status            String    @default("IN_STOCK")
  currentLocationId String?
  currentLocation   Location? @relation(fields: [currentLocationId], references: [id])
  currentBinId      String?
  receivedAt        DateTime  @default(now())
  soldAt            DateTime?
  returnState       String?
  warrantyEnd       DateTime?
  metadata          Json?
  companyId         String    @default("default-company")
  tenantId          String    @default("tenant-invexa")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  movements         SerialMovement[]

  @@unique([itemId, serial])
  @@index([currentLocationId, status])
  @@index([companyId])
}

model SerialMovement {
  id             String       @id @default(cuid())
  serialNumberId String
  serialNumber   SerialNumber @relation(fields: [serialNumberId], references: [id])
  // RECEIVE | TRANSFER | PICK | PACK | SALE | RETURN | ADJUSTMENT
  movementType   String
  fromLocationId String?
  toLocationId   String?
  fromStatus     String?
  toStatus       String
  // Ties this movement to the stock ledger/order/transfer transaction that
  // caused it, e.g. a StockMovement id or Order id - not an FK so a serial
  // movement never blocks on the source row's lifecycle.
  reference      String?
  actorId        String?
  createdAt      DateTime     @default(now())

  @@index([serialNumberId, createdAt])
}


// Blueprint v4 §12 / Appendix A: monthly stock-take campaign. FK-free like
// the other rule/result tables (restricted-MySQL hosting); joined in code.
model StockTakeCampaign {
  id                String    @id @default(cuid())
  companyId         String    @default("default-company")
  tenantId          String    @default("tenant-invexa")
  name              String
  locationId        String
  // DRAFT | ACTIVE | COUNTING | IN_REVIEW | COMPLETED | PAUSED | CANCELLED
  status            String    @default("DRAFT")
  dailyItemsPerUser Int
  userIds           Json
  priorityOrder     Json
  includeNewStock   Boolean   @default(true)
  timezone          String    @default("Asia/Kolkata")
  startDate         String
  endDate           String?
  lastRunDate       String?
  pausedFrom        String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  activatedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?

  @@index([companyId, locationId, status])
  @@index([tenantId])
}

model StockTakeCampaignItem {
  campaignId     String
  itemId         String
  // PENDING | ASSIGNED | SUBMITTED | APPROVED | RECOUNT | DISPOSITIONED | EXCLUDED
  status         String    @default("PENDING")
  excludedReason String?
  assignedToId   String?
  assignmentId   String?
  countId        String?
  assignedDate   DateTime?
  lastCountedAt  DateTime?
  recounts       Int       @default(0)
  addedAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@id([campaignId, itemId])
  @@index([campaignId, status])
}

model TransferEvidence {
  id         String   @id @default(cuid())
  transferId String
  fileName   String
  mimeType   String
  byteSize   Int
  uploadedBy String
  createdAt  DateTime @default(now())
  contents   Bytes

  @@index([transferId])
}

model ItemPhoto {
  id         String   @id @default(cuid())
  itemId     String
  fileName   String
  mimeType   String
  byteSize   Int
  isPrimary  Boolean  @default(false)
  uploadedBy String
  createdAt  DateTime @default(now())
  contents   Bytes

  @@index([itemId])
}

// Durable invalidation journal: survives process restarts and is readable by
// every API replica. SSE uses this table as its replay cursor source.
model DomainEventOutbox {
  id          BigInt   @id @default(autoincrement())
  topic       String
  companyId   String
  locationIds Json?
  actorId     String?
  requestId   String?
  occurredAt  DateTime @default(now())

  // Week 7: worker delivery state. `status` starts PENDING; the worker moves
  // it to DELIVERED on success or, after MAX_DELIVERY_ATTEMPTS failures, to
  // POISON (a visible, queryable exception - never silently dropped).
  // `availableAt` is the retry/backoff gate: a failed attempt pushes it
  // forward instead of retrying immediately. The status column itself is
  // this worker's durable cursor - `SELECT ... WHERE status = 'PENDING'
  // FOR UPDATE SKIP LOCKED` needs no separate offset table and is safe for
  // more than one worker process to poll concurrently.
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lastError   String?
  deliveredAt DateTime?

  @@index([companyId, id])
  @@index([occurredAt])
  @@index([status, availableAt])
}

// Guide Week 15: every delivery to the signed marketplace webhook is recorded
// (provider, event id, payload checksum, processing state) so a duplicate or
// replayed delivery is recognised by a database constraint - not only by the
// order-level externalReference lookup - and is traceable from event to order.
model ChannelWebhookEvent {
  id              String    @id @default(cuid())
  connectorId     String
  companyId       String    @default("default-company")
  provider        String
  eventId         String
  payloadChecksum String
  state           String    @default("RECEIVED")
  orderId         String?
  error           String?   @db.Text
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([connectorId, eventId])
  @@index([companyId, receivedAt])
  @@index([orderId])
}


// Virtual bundle/kit: the bundle item owns no stock of its own; how many can
// be sold is derived from its components (lib/bundle-availability.ts).
// Quantity is Decimal, not Float (prohibited pattern #3).
model ItemBundleComponent {
  id              String   @id @default(cuid())
  bundleItemId    String
  bundle          Item     @relation("BundleParent", fields: [bundleItemId], references: [id], onDelete: Cascade)
  componentItemId String
  component       Item     @relation("BundleComponent", fields: [componentItemId], references: [id], onDelete: Cascade)
  quantity        Decimal  @db.Decimal(12, 3)
  companyId       String   @default("default-company")
  tenantId        String   @default("tenant-invexa")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([bundleItemId, componentItemId])
  @@index([companyId])
  @@index([componentItemId])
}


// Phase 5: optional TOTP two-factor sign-in. secretEnc is AES-256-GCM
// (lib/totp.ts); backup codes are stored only as HMAC hashes (JSON array).
// lastUsedStep makes each 30-second step usable once (replay protection).
model UserTotp {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEnc        String    @db.Text
  enabledAt        DateTime?
  lastUsedStep     Int       @default(0)
  backupCodeHashes String    @default("[]") @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Phase 5: per-account sign-in failure counter (lib/login-lockout.ts). `key`
// is the lowercased email, or "2fa:<userId>" for second-factor attempts.
model AuthLockout {
  key         String    @id
  failedCount Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}


// Plan P0-SYNC-003: exactly-once replay. One row per (company, user, X-Mutation-Id);
// the first request claims it (unique constraint), a successful response is stored and
// replayed for retries. Pruned after 7 days (lib/mutation-idempotency.ts).
model MutationReceipt {
  id           String   @id @default(cuid())
  companyId    String
  userId       String
  mutationId   String
  fingerprint  String
  state        String   @default("IN_PROGRESS")
  statusCode   Int?
  responseBody String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, userId, mutationId])
  @@index([createdAt])
}


// Plan Area B WP4: one row per stock reconciliation (journal sum vs StockLedger balance).
// Read-only evidence - reconciliation never edits movements or balances.
model ReconciliationRun {
  id               String   @id @default(cuid())
  companyId        String?
  trigger          String   @default("manual")
  startedAt        DateTime
  finishedAt       DateTime
  ledgerRows       Int
  explained        Int
  mismatches       Int
  noJournalHistory Int
  mismatchAbsDelta Float
  maxAbsDelta      Float
  sampleJson       String   @db.Text
  createdAt        DateTime @default(now())

  @@index([companyId, startedAt])
}

// Passkeys (WebAuthn): one row per registered authenticator. `credentialId` is the base64url id the browser
// presents at sign-in; `publicKey` is the COSE key (public material, not a secret). `counter` is the signature
// counter, checked on every assertion so a cloned authenticator is noticed.
model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String    @default("[]") @db.Text
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}
