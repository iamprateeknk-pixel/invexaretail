// Enhanced Import with Row Details
model ImportRow {
  id              String   @id @default(cuid())
  importBatchId   String
  importBatch     ImportBatch @relation(fields: [importBatchId], references: [id])
  rowNumber       Int
  rawData         Json
  status          String   @default("DRAFT")
  errors          Json?
  warnings        Json?
  mappedData      Json?
